{% render 'befree-tokens' %}
{% liquid
 assign cta_url = section.settings.cta_url
 if cta_url == blank and section.settings.product != blank
  assign cta_url = section.settings.product.url
 endif
 if cta_url == blank
  assign cta_url = routes.root_url | append: '#bundle'
 endif
%}
{% capture navigation %}{% for block in section.blocks %}{% if block.settings.label != blank %}{% assign destination = block.settings.url %}{% if destination == blank %}{% assign destination = routes.root_url | append: '#' | append: block.settings.anchor %}{% endif %}<a class="bf-header__nav-link" href="{{ destination | escape }}"{% if destination == request.path %} aria-current="page"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>{% endif %}{% endfor %}{% endcapture %}
{% capture cta %}<a class="bf-header__cta" href="{{ cta_url | escape }}"><span>{{ section.settings.cta_label | escape }}</span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>{% endcapture %}
<befree-header class="bf-header" data-sticky="{{ section.settings.sticky }}" data-motion="{{ section.settings.motion }}" data-delay="{{ section.settings.delay }}" data-cart-json="{{ routes.cart_url }}.js" style="--bfh-bg:{{ section.settings.background }};--bfh-ink:{{ section.settings.text_color }};--bfh-green:{{ section.settings.button_color }};--bfh-button-ink:{{ section.settings.button_text }};--bfh-gold:{{ section.settings.accent }};--bfh-logo:{{ section.settings.logo_width }}px;--bfh-mobile-logo:{{ section.settings.mobile_logo_width }}px;--bfh-height:{{ section.settings.height }}px;--bfh-width:{{ section.settings.content_width }}px;">
 <div class="bf-header__inner">
  <details class="bf-header__mobile" data-header-reveal>
   <summary class="bf-header__toggle" aria-label="{{ section.settings.menu_label | escape }}"><svg class="bf-header__menu-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 8h18M3 16h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><svg class="bf-header__close-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></summary>
   <div class="bf-header__panel"><p class="bf-header__panel-label">{{ section.settings.menu_heading | escape }}</p><nav aria-label="{{ section.settings.menu_label | escape }}">{{ navigation }}</nav>{{ cta }}</div>
  </details>
  <a class="bf-header__brand" href="{{ routes.root_url }}" data-header-reveal>{% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 480 | image_tag: widths: '240, 360, 480', sizes: '(max-width: 1000px) 124px, 154px', loading: 'eager', fetchpriority: 'high', alt: shop.name }}{% else %}<img src="{{ 'befree-header-logo.webp' | asset_url }}" width="480" height="141" loading="eager" fetchpriority="high" decoding="async" alt="{{ shop.name | escape }}">{% endif %}</a>
  <nav class="bf-header__desktop" aria-label="{{ section.settings.menu_label | escape }}" data-header-reveal>{{ navigation }}</nav>
  <div class="bf-header__actions" data-header-reveal>{{ cta }}<a class="bf-header__cart" href="{{ routes.cart_url }}" aria-label="{{ section.settings.cart_label | escape }}"{% if cart.item_count == 0 %} hidden{% endif %}><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 7.5h14l1 14H4l1-14ZM8.5 8V6a3.5 3.5 0 0 1 7 0v2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="bf-header__count" aria-live="polite">{{ cart.item_count }}</span></a></div>
 </div>
</befree-header>
{% stylesheet %}
html{scroll-padding-top:80px}@media(max-width:1000px){html{scroll-padding-top:72px}}
.bf-header-section{position:sticky;top:0;z-index:40}.bf-header-section:has(.bf-header[data-sticky="false"]){position:relative}
.bf-header{display:block;position:relative;background:var(--bfh-bg,var(--bf-cream,#f8f6ef));color:var(--bfh-ink,var(--bf-green-800,#223d28));font-family:var(--bf-sans,system-ui,-apple-system,"Segoe UI",sans-serif);font-size:14px;font-weight:500;line-height:1.5;isolation:isolate;border-bottom:1px solid color-mix(in srgb,var(--bfh-gold,var(--bf-gold,#eda335)) 14%,transparent)}
.bf-header *{box-sizing:border-box}.bf-header a{color:inherit;text-decoration:none}.bf-header button,.bf-header summary{font:inherit;color:inherit}.bf-header svg{width:22px;height:22px;display:block}.bf-header :focus-visible{outline:2px solid var(--bfh-green,var(--bf-green-900));outline-offset:5px;border-radius:3px}
.bf-header__inner{max-width:var(--bfh-width,1320px);margin:auto;padding:0 40px;min-height:var(--bfh-height,88px);display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:36px;transition:min-height 300ms ease}
.bf-header__brand{display:flex;width:var(--bfh-logo,154px);max-width:100%;align-items:center;justify-self:start;min-height:44px;transition:width 300ms ease}.bf-header__brand img{display:block;width:100%;height:auto;max-height:54px;object-fit:contain}
.bf-header__desktop{display:flex;align-items:center;gap:32px;white-space:nowrap}.bf-header__nav-link{display:flex;align-items:center;min-height:44px;position:relative;font-size:13px;font-weight:500;letter-spacing:.015em}.bf-header__nav-link::after{content:"";position:absolute;inset:auto 0 8px;height:1px;background:var(--bfh-gold,var(--bf-gold));transform:scaleX(0);transform-origin:left;transition:transform 250ms ease}.bf-header__nav-link:hover::after{transform:scaleX(1)}
.bf-header__nav-link[aria-current="page"]{font-weight:600}.bf-header__nav-link[aria-current="page"]::after{height:2px;background:var(--bf-gold-ink,#be7c00);transform:scaleX(1)}
.bf-header__actions{display:flex;gap:18px;align-items:center;justify-self:end}.bf-header .bf-header__cta{display:inline-flex;align-items:center;justify-content:center;gap:22px;min-height:46px;padding:12px 20px;border-radius:5px;background:var(--bfh-green,var(--bf-green-900,#1f4127));color:var(--bfh-button-ink,var(--bf-cream-hi,#fffdf5));font-size:12px;font-weight:600;letter-spacing:.025em;white-space:nowrap;box-shadow:inset 0 0 0 1px #ffffff0a;transition:background 220ms ease,box-shadow 220ms ease}.bf-header__cta svg{width:17px;height:17px;transition:transform 250ms ease}.bf-header__cta:hover{box-shadow:inset 0 0 0 1px var(--bfh-gold,var(--bf-gold)),0 4px 14px #153e3210}.bf-header__cta:hover svg{transform:translate(2px,-2px)}
.bf-header__cart{position:relative;display:flex;align-items:center;justify-content:center;width:44px;height:44px;flex-shrink:0}.bf-header__cart[hidden]{display:none}.bf-header__count{position:absolute;top:0;right:-1px;background:var(--bfh-green,var(--bf-green-900));color:var(--bfh-button-ink,var(--bf-cream-hi));min-width:17px;height:17px;border-radius:50%;padding:0 3px;font-size:10px;line-height:17px;text-align:center}
.bf-header__mobile{display:none}.bf-header__toggle{list-style:none;display:flex;width:44px;height:44px;align-items:center;justify-content:center;cursor:pointer}.bf-header__toggle::-webkit-details-marker{display:none}.bf-header__close-icon{display:none!important}.bf-header__mobile[open] .bf-header__menu-icon{display:none}.bf-header__mobile[open] .bf-header__close-icon{display:block!important}
.bf-header__panel{position:absolute;top:100%;left:0;right:0;background:var(--bfh-bg,var(--bf-cream));border-bottom:1px solid color-mix(in srgb,var(--bfh-gold,var(--bf-gold)) 45%,transparent);padding:26px 26px 32px;box-shadow:0 24px 32px #153e3212;max-height:calc(100dvh - 70px);overflow:auto;overscroll-behavior:contain}.bf-header__panel-label{margin:0 0 20px;font-size:10px;letter-spacing:.18em;text-transform:uppercase;opacity:.65}.bf-header__panel nav{display:flex;flex-direction:column}.bf-header__panel .bf-header__nav-link{font-size:23px;font-weight:450;min-height:66px;border-bottom:1px solid #223d2814;white-space:normal;overflow-wrap:anywhere}.bf-header__panel .bf-header__nav-link::after{display:none}.bf-header__panel .bf-header__cta{display:flex;margin-top:28px;min-height:50px;justify-content:space-between;font-size:14px}
.bf-header[data-compact="true"]{box-shadow:0 5px 22px #153e3207;border-bottom-color:color-mix(in srgb,var(--bfh-gold,var(--bf-gold)) 38%,transparent)}.bf-header[data-compact="true"] .bf-header__inner{min-height:68px}.bf-header[data-compact="true"] .bf-header__brand{width:calc(var(--bfh-logo,154px)*.91)}
@media(max-width:1000px){.bf-header__inner{padding:0 14px;min-height:72px;grid-template-columns:44px minmax(0,1fr) auto;gap:10px}.bf-header__desktop{display:none}.bf-header__mobile{display:block;grid-column:1;grid-row:1;justify-self:start}.bf-header__brand{grid-column:2;grid-row:1;justify-self:center;width:100%;max-width:var(--bfh-mobile-logo,124px)}.bf-header__actions{grid-column:3;grid-row:1;gap:6px}.bf-header__actions>.bf-header__cta{min-height:44px;padding:11px 14px;gap:0;font-size:11.5px;letter-spacing:.02em}.bf-header__actions>.bf-header__cta svg{display:none}.bf-header__cart{width:44px;height:44px}.bf-header[data-compact="true"] .bf-header__inner{min-height:64px}.bf-header[data-compact="true"] .bf-header__brand{width:100%}}
@media(max-width:360px){.bf-header__inner{padding:0 10px;gap:9px}.bf-header__actions>.bf-header__cta{padding:10px 11px;font-size:11px}}
@media(prefers-reduced-motion:reduce){.bf-header *{transition:none!important;animation:none!important}html{scroll-behavior:auto}}.bf-header[data-motion="false"] *{transition:none!important;animation:none!important}
@media(forced-colors:active){.bf-header{background:Canvas;color:CanvasText;border-bottom:1px solid CanvasText}.bf-header .bf-header__cta{border:1px solid ButtonText;background:ButtonFace;color:ButtonText}.bf-header__panel{background:Canvas}}

{% endstylesheet %}
{% javascript %}
if(!customElements.get('befree-header')){
 customElements.define('befree-header',class extends HTMLElement{
  connectedCallback(){
   this.effects=[];this.cleanups=[];this.menu=this.querySelector('.bf-header__mobile');this.reduce=matchMedia('(prefers-reduced-motion: reduce)');
   const listen=(el,event,fn,options)=>{el.addEventListener(event,fn,options);this.cleanups.push(()=>el.removeEventListener(event,fn,options));};
   this.onScroll=()=>{this.dataset.compact=String(this.dataset.sticky==='true'&&scrollY>48);};
   listen(window,'scroll',this.onScroll,{passive:true});this.onScroll();
   listen(window,'resize',()=>{this.finish();if(innerWidth>1000)this.menu.open=false;});
   listen(this.reduce,'change',()=>this.finish());listen(this,'focusin',()=>this.finish());
   listen(this,'keydown',e=>{if(e.key==='Escape'&&this.menu.open){this.menu.open=false;this.menu.querySelector('summary').focus();}});
   listen(document,'click',e=>{if(this.menu.open&&!this.menu.contains(e.target))this.menu.open=false;});
   listen(this.menu,'click',e=>{if(e.target.closest('a'))this.menu.open=false;});
   listen(this.menu,'toggle',()=>{if(this.menu.open&&!this.reduce.matches&&this.dataset.motion==='true')this.querySelector('.bf-header__panel').animate([{opacity:0,transform:'translateY(-6px)'},{opacity:1,transform:'none'}],{duration:240,easing:'ease-out'});});
   listen(window,'pageshow',e=>{if(e.persisted)this.refreshCart();});
   listen(document,'cart:updated',()=>this.refreshCart());
   this.frame=requestAnimationFrame(()=>this.play());
  }
  disconnectedCallback(){cancelAnimationFrame(this.frame);this.finish();this.cleanups?.forEach(fn=>fn());}
  finish(){for(const effect of this.effects||[])effect.cancel();this.effects=[];}
  play(delay=Number(this.dataset.delay)||0){
   this.finish();if(this.reduce.matches||this.dataset.motion!=='true')return;
   const elements=[...this.querySelectorAll('[data-header-reveal]')].filter(el=>el.getClientRects().length);
   this.effects=elements.map((el,i)=>el.animate([{opacity:0,transform:'translateY(7px)'},{opacity:1,transform:'translateY(0)'}],{duration:600,delay:Math.min(4500,Math.max(0,delay))+i*90,fill:'backwards',easing:'cubic-bezier(.2,.7,.2,1)'}));
  }
  async refreshCart(){
   if(!this.dataset.cartJson)return;
   try{const response=await fetch(this.dataset.cartJson,{headers:{Accept:'application/json'}});if(!response.ok)return;const cart=await response.json();if(!Number.isInteger(cart.item_count))return;this.querySelector('.bf-header__count').textContent=String(cart.item_count);this.querySelector('.bf-header__cart').hidden=cart.item_count===0;}catch{}
  }
 });
}

{% endjavascript %}
{% schema %}
{
  "name": "BeFree · Header",
  "tag": "header",
  "class": "bf-header-section",
  "limit": 1,
  "enabled_on": {
    "groups": [
      "header"
    ],
    "templates": [
      "*"
    ]
  },
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Brand and layout"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "The original BeFree logo is included. Upload another image to replace it."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Desktop logo width",
      "min": 100,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 154
    },
    {
      "type": "range",
      "id": "mobile_logo_width",
      "label": "Mobile logo width",
      "min": 90,
      "max": 150,
      "step": 2,
      "unit": "px",
      "default": 124
    },
    {
      "type": "range",
      "id": "height",
      "label": "Desktop height",
      "min": 76,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Maximum width",
      "min": 1000,
      "max": 1600,
      "step": 40,
      "unit": "px",
      "default": 1320
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Keep header visible while scrolling",
      "default": true
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Get the System"
    },
    {
      "type": "product",
      "id": "product",
      "label": "System product",
      "info": "The button follows this product URL unless a custom destination is selected."
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Custom button destination",
      "info": "When no product or custom link is set, links to #bundle on the home page for later assembly."
    },
    {
      "type": "text",
      "id": "menu_heading",
      "label": "Mobile menu heading",
      "default": "Your next chapter"
    },
    {
      "type": "text",
      "id": "menu_label",
      "label": "Navigation accessibility label",
      "default": "Menu"
    },
    {
      "type": "text",
      "id": "cart_label",
      "label": "Cart accessibility label",
      "default": "Shopping bag",
      "info": "The cart only appears once something is in it, so the first screen carries one action."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#F8F6EF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text and icons",
      "default": "#223D28"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#1F4127"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#FFFDF5"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Gold detail",
      "default": "#EDA335",
      "info": "Decorative only: the rule under the header and the hover underline. The current-page marker uses a darker gold that reaches 3:1."
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "checkbox",
      "id": "motion",
      "label": "Enable gentle motion",
      "default": true
    },
    {
      "type": "range",
      "id": "delay",
      "label": "Entrance delay",
      "min": 0,
      "max": 4500,
      "step": 50,
      "unit": "ms",
      "default": 0,
      "info": "Leave at zero while the header loads first. Raise it only if an announcement bar is placed above it, to the length of that bar."
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Navigation link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "The System"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Destination",
          "info": "Optional. Overrides the home page section anchor below."
        },
        {
          "type": "text",
          "id": "anchor",
          "label": "Home page section anchor",
          "default": "system"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BeFree · Header",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "label": "The System",
            "anchor": "system"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "How It Works",
            "anchor": "how-it-works"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "FAQs",
            "anchor": "faq"
          }
        }
      ]
    }
  ]
}
{% endschema %}
